<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Insets?>
<GridPane alignment="CENTER" xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="com.mycompany.app.AdminRegistrationController"
          prefHeight="100.0" prefWidth="200.0">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Admin Registration"
           style="-fx-font-size:18px;-fx-font-weight:bold;"
           GridPane.rowIndex="0" GridPane.columnSpan="2"/>

    <Label text="Admin Name:" GridPane.rowIndex="1"/>
    <TextField fx:id="fullNameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Username:" GridPane.rowIndex="2"/>
    <TextField fx:id="usernameField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Label text="Password:" GridPane.rowIndex="3"/>
    <PasswordField fx:id="passwordField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <HBox spacing="10" GridPane.rowIndex="4" GridPane.columnIndex="1">
        <Button text="Back" onAction="#onBack"/>
        <Button text="Register" onAction="#onRegister"/>
    </HBox>

    <Label fx:id="messageLabel" style="-fx-text-fill:red;"
           GridPane.rowIndex="5" GridPane.columnSpan="2"/>
</GridPane>
