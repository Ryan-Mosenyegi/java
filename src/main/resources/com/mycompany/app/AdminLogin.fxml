<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane alignment="CENTER" hgap="10" vgap="10" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.app.AdminLoginController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Admin Login"
           style="-fx-font-size:18px;-fx-font-weight:bold;"
           GridPane.rowIndex="0" GridPane.columnSpan="2"/>

    <Label text="Admin ID:" GridPane.rowIndex="1"/>
    <TextField fx:id="adminIdField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Password:" GridPane.rowIndex="2"/>
    <PasswordField fx:id="passwordField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <HBox spacing="10" GridPane.rowIndex="3" GridPane.columnIndex="1">
        <Button text="Back" onAction="#onBack"/>
        <Button text="Login" onAction="#onLogin"/>
        <Button text="Register Admin" onAction="#onRegister"/>
    </HBox>

    <Label fx:id="messageLabel" GridPane.rowIndex="4" GridPane.columnSpan="2"
           style="-fx-text-fill:red;"/>
</GridPane>
