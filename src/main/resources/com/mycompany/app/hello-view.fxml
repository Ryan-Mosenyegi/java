<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.app.HomeController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Welcome to the Bank System" style="-fx-font-size:18px; -fx-font-weight:bold;"/>
    <Button text="Customer Registration" onAction="#onCustomerRegister" prefWidth="220"/>
    <Button text="Customer Login" onAction="#onCustomerLogin" prefWidth="220"/>
    <Button text="Staff / Admin Login" onAction="#onAdminLogin" prefWidth="220"/>
</VBox>
