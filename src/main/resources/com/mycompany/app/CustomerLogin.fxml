<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane alignment="CENTER"
          xmlns="http://javafx.com/javafx/17.0.12"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.mycompany.app.CustomerLoginController"
          hgap="10" vgap="10">


    <Label text="Customer Login" style="-fx-font-size:18px; -fx-font-weight:bold;"
           GridPane.columnSpan="2" GridPane.rowIndex="0"/>

    <Label text="Customer ID:" GridPane.rowIndex="1"/>
    <TextField fx:id="customerIdField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

    <Label text="Password:" GridPane.rowIndex="2"/>
    <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

    <HBox spacing="10" GridPane.rowIndex="3" GridPane.columnIndex="1" alignment="CENTER_RIGHT">
        <Button text="Back" onAction="#onBack"/>
        <Button text="Login" onAction="#onLogin"/>
    </HBox>

    <Label fx:id="messageLabel" style="-fx-text-fill:red;"
           GridPane.columnSpan="2" GridPane.rowIndex="4"/></GridPane>
