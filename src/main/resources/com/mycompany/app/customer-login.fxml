<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane alignment="CENTER"
          xmlns="http://javafx.com/javafx/17.0.12"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.mycompany.app.CustomerLoginController"
          hgap="10" vgap="10">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Customer Login"
           style="-fx-font-size:16px; -fx-font-weight:bold;"
           GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="0"/>

    <Label text="Customer ID:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
    <TextField fx:id="customerIdField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

    <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
    <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

    <HBox spacing="10" alignment="CENTER_RIGHT" GridPane.columnIndex="1" GridPane.rowIndex="3">
        <Button text="Back" onAction="#onBack"/>
        <Button text="Login" onAction="#onLogin"/>
    </HBox>

    <Label fx:id="messageLabel"
           GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4"
           style="-fx-text-fill:red;"/>
</GridPane>
